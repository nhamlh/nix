# ── Sway extraConfig ──────────────────────────────────────────────────────────
# This file serves as a supplement to the structured sway config defined in
# ../default.nix via home-manager's wayland.windowManager.sway.
#
# Most settings (keybindings, modes, colors, gaps, input, startup, etc.) are
# handled in the Nix module. This file contains only:
#   - $set variables referenced by the structured config
#   - Raw sway commands without a structured config equivalent
#   - Comments for documentation

# ── Variables referenced by structured config ────────────────────────────────
set $mod Mod4
set $term ghostty
set $menu rofi -i -combi-modi window,drun -show combi -modi combi
set $lock slock

# ── Floating modifier ────────────────────────────────────────────────────────
# Use $mod (Super) to drag floating windows
floating_modifier $mod

# ── Output scaling ───────────────────────────────────────────────────────────
output "*" scale 1

# ── Client background color ──────────────────────────────────────────────────
# Fallback background for client windows (Solarized base03)
client.background #002b36

# ── Screenshot keybindings (not in structured config) ────────────────────────
bindsym F3 exec grim
bindsym F4 exec grim -g "$(slurp)"

# ── Search key (not in structured config) ────────────────────────────────────
bindsym XF86Search exec $menu
